    "src/",
    "scripts/",
    "docs/ARCHITECTURE.md",
    "docs/CONFIGURATION.md",
    "docs/EXPERIENCE_CHECKLIST.md",
    "docs/INSTALLATION.md",
    "docs/KNOWN_ISSUES.md",
    "docs/NPM_PACKAGE_ACCEPTANCE.md",
    "docs/PRODUCT_POSITIONING.md",
    "docs/RELEASE_CHECKLIST.md",
