{
  "name": "@tianniansz/feishu-codex-bridge",
  "version": "0.2.0",
  "description": "通过自己的飞书机器人远程续聊本机 Codex Task",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianniansz/feishu-codex-bridge.git"
  },
  "homepage": "https://github.com/tianniansz/feishu-codex-bridge#readme",
  "bugs": {
