# 必填：lark-cli 配置名称
LARK_CLI_PROFILE=codex-bridge

# 必填：允许机器人操作 Codex Task 的本地目录；多个目录用英文分号分隔
ALLOWED_WORKSPACE_ROOTS=D:\Projects

# 安全默认值
ALLOW_CREATE_TASK=false
ALLOW_GROUP_CHATS=false

# 可选高级配置
LARK_CLI_BIN=lark-cli.cmd
LARK_EVENT_AS=bot
LARK_CLI_REPLY_AS=bot
CODEX_BIN=codex
CODEX_APP_SERVER_TIMEOUT_MS=3600000
TASK_LIMIT=50
TASK_PAGE_SIZE=8
RUNNING_NOTICE_DELAY_MS=180000
PROGRESS_NOTICE_INTERVAL_MS=60000
PAIRING_TTL_MINUTES=10
RUNTIME_DIR=.runtime
